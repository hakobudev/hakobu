package cmd

import (
	"fmt"
	"strings"

	"github.com/hakobudev/hakobu/internal/store"
)

// projectView is a project's pages: its canvas, shared variables
// and settings.
type projectView struct {
	Project          store.Project
	Tab              string // "", "variables" or "settings"
	PanelOnly        bool   // the panel's own server and account aren't offered
	PanelAccount     string // how the panel's account is offered
	Apps             []appView
	Workers          map[string]workerCard
	LastDeploy       map[string]store.DeployLog
	Databases        []store.Database
	LastBackup       map[string]store.Backup
	Storages         []store.Storage
	Caches           []store.Cache
	Sealed           []string
	SuggestedDB      string
	SuggestedStorage string
	SuggestedCache   string
	R2Off            bool   // R2 isn't on in the project's account
	R2URL            string // where it's turned on
	BackupBucket     string
	Volumes          map[string][]volumeCard // by app
	Calls            map[string][]string     // app → apps whose address its variables name
	Client           string   // the client whose Cloudflare account the project is in, "" for yours
	Clients          []string // every client, to move the project to
	Server           string   // the server it runs on, "" for the panel's
	Servers          []string // the servers that joined, to move it to while it's empty
}

// volumeCard is an app's volume on the canvas, with its latest backup.
type volumeCard struct {
	store.Volume
	Last    store.VolumeBackup
	HasLast bool
}


// empty reports whether the project has no data at all.
func (v projectView) empty() bool {
	n := len(v.Databases) + len(v.Storages) + len(v.Caches)
	for _, vols := range v.Volumes {
		n += len(vols)
	}
	return n == 0
}


// appLinksOf is what an app's card draws lines to: its database, storage
// and volumes.
func (v projectView) appLinksOf(a appView) string {
	links := appLinks(a)
	for _, vol := range v.Volumes[a.Name] {
		links += " vol-" + a.Name + "-" + vol.Name
	}
	return links
}

func (v projectView) callsOf(app string) string {
	ids := ""
	for _, b := range v.Calls[app] {
		ids += " app-" + b
	}
	return ids
}

// appTiers lays the apps out left to right the way requests go: the apps
// that call others, and aren't called by any, on the left; the rest, next
// to the data, on the right. Apps that call each other (a frontend and the
// API that names it for CORS, say) count as one and stay together. One
// column when no app calls another across.
func (v projectView) appTiers() [][]appView {
	n := len(v.Apps)
	idx := make(map[string]int, n)
	for i, a := range v.Apps {
		idx[a.Name] = i
	}
	calls, reach := make([][]bool, n), make([][]bool, n)
	for i, a := range v.Apps {
		calls[i], reach[i] = make([]bool, n), make([]bool, n)
		for _, b := range v.Calls[a.Name] {
			if j, ok := idx[b]; ok && j != i {
				calls[i][j], reach[i][j] = true, true
			}
		}
	}
	for k := range n {
		for i := range n {
			for j := range n {
				reach[i][j] = reach[i][j] || reach[i][k] && reach[k][j]
			}
		}
	}
	// group[i]: the apps i calls and is called by, itself included.
	group := func(i int) []int {
		g := []int{i}
		for j := range n {
			if j != i && reach[i][j] && reach[j][i] {
				g = append(g, j)
			}
		}
		return g
	}
	var tiers [2][]appView
	for i, a := range v.Apps {
		caller, called := false, false
		for _, m := range group(i) {
			for j := range n {
				caller = caller || calls[m][j] && !reach[j][m]
				called = called || calls[j][m] && !reach[m][j]
			}
		}
		if caller && !called {
			tiers[0] = append(tiers[0], a)
		} else {
			tiers[1] = append(tiers[1], a)
		}
	}
	if len(tiers[0]) == 0 {
		return [][]appView{tiers[1]}
	}
	return tiers[:]
}

func (v projectView) path(tab string) string {
	if tab == "" {
		return "/projects/" + v.Project.Name
	}
	return "/projects/" + v.Project.Name + "/" + tab
}

// appLinks is what an app's card draws lines to.
// workerCard is an app's worker on the project canvas.
type workerCard struct {
	Name, Command, Status string
}

func appLinks(a appView) string {
	links := ""
	if a.LinkedDB != "" {
		links += "db-" + a.LinkedDB
	}
	if a.LinkedStorage != "" {
		links += " st-" + a.LinkedStorage
	}
	if a.LinkedCache != "" {
		links += " cache-" + a.LinkedCache
	}
	return links
}

// builder names what builds the app's image.
func builder(a appView) string {
	if a.BuildStrategy == "dockerfile" {
		return "Dockerfile"
	}
	return "Railpack"
}

// appKind is what the app's card says under its name: its framework (or
// language) and builder; its address, or that it has none, a row of its own.
func appKind(a appView) string {
	kind := builder(a)
	if parts := strings.Split(a.Stack, " · "); a.Stack != "" {
		kind = strings.TrimSpace(parts[len(parts)-1]) + " · " + kind
	}
	return kind
}

// shortDeployLabel is the last deploy beside the card's uptime: how it was
// started, unless it failed or still runs.
func shortDeployLabel(d store.DeployLog) string {
	if d.Status == "success" {
		return d.Trigger
	}
	return deployLabel(d)
}

func storageKind(st store.Storage) string {
	if st.Provider == "r2" {
		return "Cloudflare R2 · " + st.Bucket
	}
	return "S3 · " + st.Bucket
}

templ projectPage(v projectView) {
	@shell(v.Project.Name, projectCrumb(v.Project.Name)) {
		@pageHeader(pageHead{Title: v.Project.Name, Meta: projectMeta(v), Actions: projectNew(v)})
		@tabBar([]tab{
			{Label: "Overview", Icon: "layers", Href: v.path(""), Current: v.Tab == ""},
			{Label: "Shared variables", Icon: "key-round", Href: v.path("variables"), Current: v.Tab == "variables"},
			{Label: "Settings", Icon: "settings", Href: v.path("settings"), Current: v.Tab == "settings"},
		})
		switch v.Tab {
			case "variables":
				@projectVariables(v)
			case "settings":
				@projectSettings(v)
			default:
				@projectCanvas(v)
		}
		@projectDialogs(v)
	}
}

templ projectMeta(v projectView) {
	<span class="meta-item">
		@ic("box")
		{ plural(len(v.Apps), "app", "apps") }
		if n := len(v.Workers); n > 0 {
			· { plural(n, "worker", "workers") }
		}
	</span>
	<span class="meta-item">
		@ic("database")
		{ plural(len(v.Databases), "database", "databases") }
	</span>
	if n := len(v.Caches); n > 0 {
		<span class="meta-item">
			@ic("zap")
			{ plural(n, "cache", "caches") }
		</span>
	}
	<span class="meta-item">
		@ic("archive")
		{ plural(len(v.Storages), "storage", "storages") }
	</span>
	if v.Server != "" {
		<span class="meta-item">
			@ic("server")
			{ "on " + v.Server }
		</span>
	}
	if v.Client != "" {
		<span class="meta-item">
			@ic("users")
			{ "client " + v.Client }
		</span>
	}
}

templ projectNew(v projectView) {
	@menu("new-menu", "New", "plus", true) {
		<button type="button" class="menu-item" data-dialog="new-app" hx-get={ "/projects/" + v.Project.Name + "/new-app" } hx-target="#new-app-form" hx-swap="innerHTML">
			<span class="meta-item strong">
				@ic("box")
				App
			</span>
			<br/>
			<span class="muted small">From a GitHub repository</span>
		</button>
		<button type="button" class="menu-item" data-dialog="new-database">
			<span class="meta-item strong">
				@ic("database")
				Database
			</span>
			<br/>
			<span class="muted small">PostgreSQL, backed up daily</span>
		</button>
		<button type="button" class="menu-item" data-dialog="new-cache">
			<span class="meta-item strong">
				@ic("zap")
				Cache
			</span>
			<br/>
			<span class="muted small">Valkey, Redis-compatible: caches, queues, sessions</span>
		</button>
		<button type="button" class="menu-item" data-dialog="new-storage">
			<span class="meta-item strong">
				@ic("archive")
				Storage
			</span>
			<br/>
			<span class="muted small">An R2 or S3 bucket for files</span>
		</button>
	}
}

// projectCanvas reads left to right like a request: the apps (those called
// by others right of their callers), then their data. An app's card has
// its address with its uptime and its problems of the last day; a data
// card says how its latest backup went.
templ projectCanvas(v projectView) {
	{{ tiers := v.appTiers() }}
	<div class="canvas">
		<svg class="canvas-lines" aria-hidden="true"></svg>
		<div class={ "canvas-cols", templ.KV("canvas-cols-tiers", len(tiers) > 1) }>
			<div class="canvas-col">
				<div class="canvas-col-title"><span>Apps</span></div>
				if len(tiers) > 1 {
					<div class="canvas-tiers">
						for _, tier := range tiers {
							<div class="canvas-tier">
								for _, a := range tier {
									@appNode(v, a)
								}
							</div>
						}
					</div>
				} else {
					for _, a := range v.Apps {
						@appNode(v, a)
					}
				}
				if len(v.Apps) == 0 {
					<p class="field-hint">No apps yet: add one from a GitHub repo with New.</p>
				}
			</div>
			<div class="canvas-col">
				<div class="canvas-col-title"><span>Data</span></div>
				for _, d := range v.Databases {
					@databaseNode(v.Project.Name, d, v.LastBackup, v.BackupBucket != "")
				}
				for _, a := range v.Apps {
					for _, vol := range v.Volumes[a.Name] {
						@volumeNode(v.Project.Name, a.Name, vol, v.BackupBucket != "")
					}
				}
				for _, c := range v.Caches {
					@cacheNode(v.Project.Name, c)
				}
				for _, st := range v.Storages {
					@storageNode(v, st)
				}
				if v.empty() {
					<p class="field-hint">No databases, caches, volumes or storages yet: add one with New.</p>
				}
			</div>
		</div>
	</div>
}

templ volumeNode(project, app string, vol volumeCard, backupsOn bool) {
	<a href={ templ.SafeURL(appPath(project, app) + "/settings#volumes") } id={ "vol-" + app + "-" + vol.Name } class="node">
		<div class="node-head">
			<span class="icon-tile">
				@ic("hard-drive")
			</span>
			<div class="min-w-0 flex-1">
				<div class="node-title">{ vol.Name }</div>
				<div class="node-kind">Volume of { app } · <span class="mono">{ vol.MountPath }</span></div>
			</div>
		</div>
		<div class="node-row">
			if vol.HasLast {
				if vol.Last.VerifyError != "" {
					<span class="meta-item text-danger">
						@ic("circle-x", "icon-sm")
						Last backup unreadable
					</span>
				} else if vol.Last.VerifiedAt != "" {
					<span class="meta-item">
						@ic("circle-check", "icon-sm text-success")
						Backup whole
					</span>
				} else {
					<span>Backed up, not checked yet</span>
				}
				<span class="tabular shrink-0">
					@timeAgo(vol.Last.CreatedAt)
				</span>
			} else if backupsOn {
				<span>No backup yet</span>
			} else {
				<span class="meta-item">
					@ic("triangle-alert", "icon-sm text-attention")
					Backups are off
				</span>
			}
		</div>
	</a>
}

templ appNode(v projectView, a appView) {
	<div id={ "app-" + a.Name } class="node" data-links={ v.appLinksOf(a) } data-calls={ v.callsOf(a.Name) }>
		<a href={ templ.SafeURL(appURL(a.App)) } class="node-link">
			<div class="node-head">
				@tile(appLogo(a.App), appIcon(a))
				<div class="min-w-0 flex-1">
					<div class="node-title">{ a.Name }</div>
					<div class="node-kind">{ appKind(a) }</div>
				</div>
				@nodeStatus(a)
			</div>
			if a.LinkedDB != "" || a.LinkedStorage != "" || a.LinkedCache != "" {
				<div class="node-chips">
					if a.LinkedDB != "" {
						<span class="badge">
							@ic("database", "icon-sm")
							{ a.LinkedDB }
						</span>
					}
					if a.LinkedStorage != "" {
						<span class="badge">
							@ic("archive", "icon-sm")
							{ a.LinkedStorage }
						</span>
					}
					if a.LinkedCache != "" {
						<span class="badge">
							@ic("zap", "icon-sm")
							{ a.LinkedCache }
						</span>
					}
				</div>
			}
		</a>
		if a.Domain != "" {
			<a href={ templ.SafeURL("https://" + a.Domain) } target="_blank" rel="noopener" class="node-item">
				<span class="meta-item min-w-0">
					@ic("globe", "icon-sm icon-muted")
					<span class="truncate">{ a.Domain }</span>
				</span>
				@ic("external-link", "icon-sm icon-muted")
			</a>
		} else {
			<div class="node-item" title="It has no public address: other apps of the project reach it">
				<span class="meta-item min-w-0 muted">
					@ic("lock", "icon-sm")
					<span class="truncate">Private, on the server only</span>
				</span>
			</div>
		}
		<a href={ templ.SafeURL(appURL(a.App) + "/deployments") } class="node-row node-uptime">
			if a.Domain != "" {
				<span class="contents" hx-get={ "/uptime?target=app:" + itoa(a.ID) + "&compact=1" } hx-trigger="load" hx-swap="outerHTML"></span>
			}
			if d, ok := v.LastDeploy[a.Name]; ok {
				<span class="meta-item min-w-0 node-deploy" title={ deployLabel(d) }>
					@deployIcon(d.Status, true)
					<span class="truncate">{ shortDeployLabel(d) + " ·" }</span>
					@timeAgo(d.CreatedAt)
				</span>
			} else {
				<span class="node-deploy">Not deployed yet</span>
			}
		</a>
		<span hx-get={ appURL(a.App) + "/problems" } hx-trigger="load" hx-swap="outerHTML"></span>
		if w, ok := v.Workers[a.Name]; ok {
			<a href={ templ.SafeURL(appURL(a.App) + "/logs?worker=1") } id={ "wk-" + a.Name } class="node-item" title="The app's worker: same image and links, its own process">
				<span class="meta-item min-w-0">
					if l := workerLogo(a.App, w.Command); l != "" {
						@logo(l)
					} else {
						@ic("workflow", "icon-sm icon-muted")
					}
					<span class="strong">{ w.Name }</span>
					<span class="mono muted truncate">{ w.Command }</span>
				</span>
				@statusIcon(w.Status)
			</a>
		}
	</div>
}

// statusIcon is a container's state as a shape as well as a color.
templ statusIcon(status string) {
	<span class="inline-flex shrink-0" title={ status }>
		switch status {
			case "running":
				@ic("circle-check", "icon-sm text-success")
			case "restarting":
				@ic("refresh-cw", "icon-sm text-attention")
			case "unknown":
				@ic("circle-dot", "icon-sm icon-muted")
			default:
				@ic("circle-x", "icon-sm text-danger")
		}
	</span>
}

// nodeStatus is an app card's state in words and a shape, not only a color.
templ nodeStatus(a appView) {
	<span class="node-status" title={ a.Status }>
		if a.Deploying {
			@ic("loader-circle", "icon-sm icon-spin text-accent")
			Deploying
		} else if a.App.Stopped == 1 && a.Status != "running" {
			@ic("circle-pause", "icon-sm")
			Stopped
		} else if a.Status == "running" {
			@ic("circle-check", "icon-sm text-success")
			Running
		} else if a.Status == "restarting" {
			@ic("refresh-cw", "icon-sm text-attention")
			Restarting
		} else if a.Status == "unknown" {
			@ic("circle-dot", "icon-sm")
			Unknown
		} else {
			@ic("circle-x", "icon-sm text-danger")
			<span class="text-danger">{ statusWord(a.Status) }</span>
		}
	</span>
}

templ databaseNode(project string, d store.Database, last map[string]store.Backup, backupsOn bool) {
	<a href={ templ.SafeURL(dbURL(project, d.Name)) } id={ "db-" + d.Name } class="node">
		<div class="node-head">
			@tile("postgresql", "database")
			<div class="min-w-0 flex-1">
				<div class="node-title">{ d.Name }</div>
				<div class="node-kind">PostgreSQL</div>
			</div>
		</div>
		<div class="node-row">
			if b, ok := last[d.Name]; ok {
				if b.VerifyError != "" {
					<span class="meta-item text-danger">
						@ic("circle-x", "icon-sm")
						Last backup doesn't restore
					</span>
				} else if b.VerifiedAt != "" {
					<span class="meta-item">
						@ic("circle-check", "icon-sm text-success")
						Backup restores
					</span>
				} else {
					<span>Backed up, not checked yet</span>
				}
				<span class="tabular shrink-0">
					@timeAgo(b.CreatedAt)
				</span>
			} else if backupsOn {
				<span>No backup yet</span>
			} else {
				<span class="meta-item">
					@ic("triangle-alert", "icon-sm text-attention")
					Backups are off
				</span>
			}
		</div>
	</a>
}

templ cacheNode(project string, c store.Cache) {
	<a href={ templ.SafeURL(cacheURL(project, c.Name)) } id={ "cache-" + c.Name } class="node">
		<div class="node-head">
			<span class="icon-tile">
				@ic("zap")
			</span>
			<div class="min-w-0 flex-1">
				<div class="node-title">{ c.Name }</div>
				<div class="node-kind">Valkey · Redis-compatible</div>
			</div>
		</div>
		<div class="node-row">
			<span class="meta-item">
				@ic("memory-stick", "icon-sm")
				{ fmt.Sprintf("%d MB", c.MemoryMB) }
			</span>
			<span>not backed up</span>
		</div>
	</a>
}

templ storageNode(v projectView, st store.Storage) {
	<a href={ templ.SafeURL(storageURL(v.Project.Name, st.Name)) } id={ "st-" + st.Name } class="node">
		<div class="node-head">
			@tile(storageLogo(st), "archive")
			<div class="min-w-0 flex-1">
				<div class="node-title">{ st.Name }</div>
				<div class="node-kind">{ storageKind(st) }</div>
			</div>
		</div>
		<div class="node-row">
			if st.AccessKeyID == "" {
				<span class="meta-item">
					@ic("triangle-alert", "icon-sm text-attention")
					Needs keys before apps can use it
				</span>
			} else {
				<span class="meta-item">
					@ic("key-round", "icon-sm")
					Keys set
				</span>
			}
		</div>
	</a>
}

templ projectVariables(v projectView) {
	<div class="space-y-6">
		<form hx-post={ "/projects/" + v.Project.Name + "/env" } class="box" id="shared-env" data-saved>
			<div class="box-header">
				<span>Shared variables</span>
			</div>
			<div class="box-body">
				<p class="field-hint">Passed to every app and worker in this project. An app's own variables override them.</p>
				@envEditor("env", string(v.Project.SharedEnv), "")
			</div>
			@boxFooter("Applies on each app's next deploy.") {
				@submit("Save", true)
			}
		</form>
		@sealedVars(v.path("") + "/sealed", v.Sealed)
	</div>
}

templ projectSettings(v projectView) {
	if len(v.Servers) > 0 && len(v.Apps) == 0 && len(v.Databases) == 0 {
		<form class="box mb-6" hx-post={ "/projects/" + v.Project.Name + "/server" }>
			<div class="box-header">Server</div>
			<div class="box-body space-y-3">
				<p class="field-hint">Where its apps, databases and volumes run. It can move while it has none.</p>
				<select name="server" class="input">
					if !v.PanelOnly {
						<option value="" selected?={ v.Server == "" }>This server, the panel's</option>
					}
					for _, sv := range v.Servers {
						<option value={ sv } selected?={ v.Server == sv }>{ sv }</option>
					}
				</select>
			</div>
			@boxFooter("") {
				@submit("Save", false)
			}
		</form>
	}
	if len(v.Clients) > 0 || v.Client != "" {
		<form class="box mb-6" hx-post={ "/projects/" + v.Project.Name + "/account" }>
			<div class="box-header">Cloudflare account</div>
			<div class="box-body space-y-3">
				<p class="field-hint">Where the project's domains, R2 storages and backups are: the panel's, or another one (Settings → Cloudflare). Apps must be private to move; storages made before stay where they are.</p>
				<select name="client" class="input">
					if !v.PanelOnly {
						<option value="" selected?={ v.Client == "" }>{ v.PanelAccount }</option>
					}
					for _, c := range v.Clients {
						<option value={ c } selected?={ v.Client == c }>{ c }</option>
					}
				</select>
			</div>
			@boxFooter("") {
				@submit("Save", false)
			}
		</form>
	}
	<div class="box box-danger">
		<div class="box-header">Danger zone</div>
		<div class="box-row">
			<div>
				<p class="strong">Delete this project</p>
				<p class="field-hint">Removes its { plural(len(v.Apps), "app", "apps") } with their volumes, its { plural(len(v.Databases), "database", "databases") } with their data, and forgets its storages (their buckets stay).</p>
			</div>
			<button
				class="btn btn-danger"
				hx-delete={ "/projects/" + v.Project.Name }
				hx-confirm={ "Every app, database and volume in " + v.Project.Name + " is deleted with its data. This can't be undone." }
				data-confirm-title={ "Delete " + v.Project.Name + "?" }
				data-confirm-action="Delete this project"
				data-confirm-name={ v.Project.Name }
			>
				@ic("trash-2")
				Delete project
			</button>
		</div>
	</div>
}

templ projectDialogs(v projectView) {
	@dialog("new-app", "New app") {
		<div id="new-app-form">
			@skeleton(3, false)
		</div>
	}
	@dialog("new-database", "New database") {
		<form hx-post={ "/projects/" + v.Project.Name + "/databases" } class="space-y-4">
			@field("Name", "Lowercase letters, digits, dashes and underscores, starting with a letter.") {
				<input name="name" class="input mono" placeholder={ namePlaceholder(v.SuggestedDB, "e.g. main") } required?={ v.SuggestedDB == "" } pattern="[a-z][a-z0-9_\-]{0,39}"/>
			}
			<p class="field-hint">PostgreSQL with its own user. Link it from an app's settings to give the app DATABASE_URL.</p>
			<button class="btn btn-primary btn-block">
				@ic("loader-circle", "btn-spinner")
				Create database
			</button>
		</form>
	}
	@dialog("new-cache", "New cache") {
		<form hx-post={ "/projects/" + v.Project.Name + "/caches" } class="space-y-4">
			@field("Name", "Lowercase letters, digits and dashes, starting with a letter.") {
				<input name="name" class="input mono" placeholder={ namePlaceholder(v.SuggestedCache, "e.g. cache") } required?={ v.SuggestedCache == "" } pattern="[a-z][a-z0-9\-]{0,39}"/>
			}
			<p class="field-hint">A Valkey server of its own, Redis-compatible, with 256 MB to start. Link it from an app's settings to give the app REDIS_URL. Its data outlives restarts but isn't backed up.</p>
			<button class="btn btn-primary btn-block">
				@ic("loader-circle", "btn-spinner")
				Create cache
			</button>
		</form>
	}
	@dialog("new-storage", "New storage") {
		<form hx-post={ "/projects/" + v.Project.Name + "/storages" } class="space-y-4">
			@field("Name", "Lowercase letters, digits and dashes, starting with a letter.") {
				<input name="name" class="input mono" placeholder={ namePlaceholder(v.SuggestedStorage, "e.g. files") } required?={ v.SuggestedStorage == "" } pattern="[a-z][a-z0-9\-]{0,39}"/>
			}
			@field("Where", "") {
				<select name="provider" class="input">
					<option value="r2">{ r2Option(v.Client) }</option>
					<option value="s3">S3-compatible (AWS, Backblaze, MinIO, …)</option>
				</select>
			}
			<div data-show-if="provider=r2">
				@field("Bucket", "") {
					<select name="r2_bucket" class="input mono" hx-get={ "/projects/" + v.Project.Name + "/r2-buckets" } hx-trigger="load" hx-swap="innerHTML">
						<option value="">New bucket</option>
					</select>
				}
			</div>
			<p class="field-hint" data-show-if="provider=r2">hakobu creates a new bucket in { accountName(v.Client) }, or takes one already there with its files; then you give it the keys of a token for that bucket alone. R2's free plan includes 10 GB, and downloads are free.</p>
			if v.R2Off {
				<div data-show-if="provider=r2">
					@r2OffFlash(accountName(v.Client), v.R2URL, r2Owner(v.Client))
				</div>
			}
			<div class="space-y-3" data-show-if="provider=s3" hidden>
				<input name="endpoint" placeholder="Endpoint URL" class="input mono"/>
				<input name="bucket" placeholder="Bucket" class="input mono"/>
				<input name="access_key_id" placeholder="Access key ID" class="input mono"/>
				<input name="secret_access_key" type="password" placeholder="Secret access key" autocomplete="new-password" class="input mono"/>
				<input name="region" placeholder="Region (default: auto)" class="input mono"/>
			</div>
			<button class="btn btn-primary btn-block">
				@ic("loader-circle", "btn-spinner")
				Add storage
			</button>
		</form>
	}
}

// r2BucketOptions are the new storage's bucket choices: a new one, or one
// of the account's.
templ r2BucketOptions(names []string, err string) {
	<option value="">New bucket</option>
	for _, n := range names {
		<option value={ n }>{ n }</option>
	}
	if err != "" {
		<option value="" disabled>{ err }</option>
	}
}

func accountName(client string) string {
	if client == "" {
		return "your Cloudflare account"
	}
	return client + "'s Cloudflare account"
}

// r2Owner is who turns R2 on in the project's account.
func r2Owner(client string) string {
	if client == "" {
		return "you"
	}
	return "the client"
}

func r2Option(client string) string {
	return "Cloudflare R2 in " + accountName(client)
}

// appProblems is the row of an app's card counting its problems (errors,
// crashes, out-of-memory kills, failed health checks) of the last day.
templ appProblems(href string, n int, more bool) {
	if n > 0 {
		<a href={ templ.SafeURL(href) } class="node-item node-item-danger">
			<span class="meta-item">
				@ic("triangle-alert", "icon-sm")
				if more {
					{ fmt.Sprintf("%d+ problems in the last day", n) }
				} else if n == 1 {
					1 problem in the last day
				} else {
					{ fmt.Sprintf("%d problems in the last day", n) }
				}
			</span>
			@ic("chevron-right", "icon-sm")
		</a>
	}
}
