package cmd

import (
	"strings"

	"github.com/x0ryz/hakobu/internal/ops"
)

// Pages before or around signing in: one box in the middle of the page.

templ centered(title string) {
	@document(title) {
		<main class="center-page">
			<div class="signin">
				{ children... }
			</div>
		</main>
	}
}

templ signinMark(title, subtitle string) {
	<div class="signin-mark">
		@wordmark(true)
		<div>
			<h1 class="signin-title">{ title }</h1>
			if subtitle != "" {
				<p class="muted mt-1">{ subtitle }</p>
			}
		</div>
	</div>
}

templ loginPage(connected bool, errMsg string) {
	@centered("Sign in") {
		@signinMark("Sign in", "")
		if errMsg != "" {
			@flash("danger") {
				{ errMsg }
			}
		}
		<div class="box">
			<div class="box-body">
				if connected {
					<a href="/auth/login" class="btn btn-github">
						@ic("github")
						Continue with GitHub
					</a>
					<p class="field-hint text-center">Only this panel's users can sign in; anyone else needs an invite link from its admin.</p>
				} else {
					<p>Setup isn't finished. Open the setup link the installer printed:</p>
					<pre class="console">journalctl -u hakobu | grep setup</pre>
				}
			</div>
		</div>
		<div class="signin-foot">
			<span class="meta-item">
				@ic("lock", "icon-sm")
				Self-hosted with Hakobu
			</span>
		</div>
	}
}

// setupView is the setup page: the GitHub App to create.
type setupView struct {
	Host, Manifest, State string
	Action                string // where the manifest is posted: the account's or Org's
	Org, Name             string // "" for the signed-in account, a made-up name
	Err                   string
}

templ setupPage(v setupView) {
	@centered("Setup") {
		@signinMark("Connect GitHub", v.Host)
		if v.Err != "" {
			@flash("danger") {
				{ v.Err }
			}
		}
		<div class="box">
			if v.Manifest != "" {
				<div class="box-body space-y-4">
					<p>This creates a GitHub App for <span class="mono">{ v.Host }</span>. It's used to sign in to this panel, clone your repos and deploy on push. You then sign in and become its admin.</p>
					<form method="post" action={ templ.SafeURL(v.Action) }>
						<input type="hidden" name="manifest" value={ v.Manifest }/>
						<input type="hidden" name="state" value={ v.State }/>
						<button class="btn btn-github">
							@ic("github")
							if v.Org != "" {
								{ "Create the GitHub App on " + v.Org }
							} else {
								Create the GitHub App
							}
						</button>
					</form>
					<details open?={ v.Org != "" || v.Name != "" }>
						<summary class="field-hint cursor-pointer">On an organization, or under a name of your own</summary>
						<form method="get" action="/setup" class="space-y-3 mt-3">
							@field("Organization", "One you own on GitHub. Leave it empty for your own account.") {
								<input name="org" value={ v.Org } placeholder="e.g. acme" class="input mono"/>
							}
							@field("App name", "What people see when they sign in. Unique on GitHub, at most 34 characters; empty makes one up.") {
								<input name="name" value={ v.Name } maxlength="34" placeholder="e.g. Acme Deploy" class="input"/>
							}
							<button class="btn btn-block">Use these</button>
						</form>
					</details>
				</div>
			} else {
				<div class="box-body">
					@flash("danger") {
						No public host is configured. Re-run the installer, or start the agent with <span class="mono">--public-host</span>.
					}
				</div>
			}
		</div>
	}
}

type consentView struct {
	Client                     oauthClient
	Query                      string
	RedirectHost, PublicHost   string
	Loopback, Document, Deploy bool
}

templ oauthConsentPage(v consentView) {
	@centered("Connect an app") {
		@signinMark("Allow "+v.Client.Name+"?", v.PublicHost)
		<form method="post" action="/oauth/authorize" class="box">
			<div class="box-body">
				<p>It gets a token for <span class="mono">{ v.PublicHost }</span> and returns to <span class="mono">{ v.RedirectHost }</span>.</p>
				if v.Document {
					<p class="field-hint">It describes itself at <span class="mono break-all">{ v.Client.ID }</span>.</p>
				}
				if v.Loopback {
					@flash("warn") {
						It returns to a program on your own computer, like Claude Code. Allow it only if you just started connecting it there: any program on that computer could ask.
					}
				}
				<label class="check">
					<input type="checkbox" checked disabled/>
					<span><span class="check-label">Read</span><br/><span class="field-hint">Projects, apps, deploys and their logs, the apps' output and errors. Not the values of variables or any other secret.</span></span>
				</label>
				if v.Deploy {
					<label class="check">
						<input type="checkbox" name="deploy" value="1" checked/>
						<span><span class="check-label">Deploy and set up</span><br/><span class="field-hint">Deploy apps, roll them back (with their database, if asked) and restart workers; make projects, apps, databases and volumes, and set variables and how apps build and start. Never delete anything or read a secret.</span></span>
					</label>
				}
				<input type="hidden" name="request" value={ v.Query }/>
			</div>
			@boxFooter("It can't delete anything or change settings.") {
				<button name="deny" value="1" class="btn">Deny</button>
				<button name="approve" value="1" class="btn btn-primary">Allow</button>
			}
		</form>
		<p class="signin-foot">Disconnect it any time in Settings → AI apps.</p>
	}
}

templ oauthErrorPage(msg string) {
	@centered("Can't connect") {
		@signinMark("Can't connect", "")
		@flash("danger") {
			<span class="break-words">{ msg }</span>
		}
	}
}

// invitePageData is what an invite link opens.
type invitePageData struct {
	Host, By string // By: who invited, if known
	Valid    bool   // not used or expired yet
}

templ invitePage(v invitePageData) {
	@centered("Invite") {
		@signinMark("You're invited", v.Host)
		if !v.Valid {
			@flash("danger") {
				This invite was used or has expired: ask for a new one.
			}
		} else {
			<div class="box">
				<div class="box-body space-y-4">
					<p>
						if v.By != "" {
							<a href={ templ.SafeURL("https://github.com/" + v.By) } target="_blank" rel="noopener" class="strong mono">{ v.By }</a> invited you to deploy on this panel.
						} else {
							You're invited to deploy on this panel.
						}
						You get a space of your own: your projects, servers and Cloudflare accounts, seen only by you.
					</p>
					<a href="/auth/login" class="btn btn-github">
						@ic("github")
						Continue with GitHub
					</a>
					<p class="field-hint text-center">The link works once, for the GitHub account you sign in with.</p>
				</div>
			</div>
		}
		<div class="signin-foot">
			<span class="meta-item">
				@ic("lock", "icon-sm")
				Self-hosted with Hakobu
			</span>
		</div>
	}
}

// cloudflarePick is the page after "Connect with Cloudflare": which of the
// accounts the sign-in reached to connect, and under what names.
type cloudflarePick struct {
	ID      string
	Choices []ops.OAuthChoice
}

templ cloudflarePickPage(v cloudflarePick) {
	@centered("Connect Cloudflare") {
		@signinMark("Connect Cloudflare", "")
		<form class="box" hx-post={ "/cloudflare/connect/" + v.ID }>
			<div class="box-body space-y-4">
				@field("Accounts", "Their domains become available to your projects; hakobu creates a tunnel in each. Names are lowercase letters, digits and dashes, shown in project settings.") {
					for _, c := range v.Choices {
						<div class="check">
							<input type="checkbox" name="account" value={ c.ID } id={ "acc-" + c.ID } checked?={ c.Taken == "" } disabled?={ c.Taken != "" }/>
							<span class="flex-1">
								<label for={ "acc-" + c.ID } class="check-label">{ c.Account.Name }</label>
								<br/>
								<span class="field-hint mono">{ strings.Join(c.Zones, ", ") }</span>
								if c.Taken != "" {
									<br/>
									<span class="field-hint">{ c.Taken }</span>
								} else {
									<input name={ "name-" + c.ID } value={ c.Name } aria-label={ "Name in hakobu for " + c.Account.Name } required pattern="[a-z][a-z0-9\-]{0,39}" class="input mono mt-2"/>
								}
							</span>
						</div>
					}
				}
				<button class="btn btn-primary btn-block">
					@ic("loader-circle", "btn-spinner")
					Connect
				</button>
			</div>
		</form>
	}
}
