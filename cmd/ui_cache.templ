package cmd

import (
	"fmt"
	"strings"

	"github.com/hakobudev/hakobu/internal/store"
)

type cachePage struct {
	Cache   store.Cache
	Project store.Project
	Status  string // its container's
	Env     []envVar
	UsedBy  []string
}

templ cacheView(v cachePage) {
	@shell(v.Cache.Name, projectCrumb(v.Project.Name), resourceCrumb(v.Project.Name, v.Cache.Name, cacheURL(v.Project.Name, v.Cache.Name), "", "zap")) {
		@pageHeader(pageHead{Icon: "zap", Title: v.Cache.Name, Mono: true, Status: cacheStatus(v.Status), Meta: cacheMeta(v.Cache)})
		<div class="space-y-10">
			@section("", "Connection", "Reachable from this project's apps only, at host "+v.Cache.Key()+" on its Docker network. Any Redis client works.", nil) {
				<div class="box">
					<div class="box-row">
						<span class="row-main">
							@ic("box", "icon-muted")
							<span>Used by</span>
						</span>
						<span class="flex flex-wrap gap-2 justify-end">
							for _, a := range v.UsedBy {
								<a href={ templ.SafeURL(appPath(v.Project.Name, a)) } class="badge">{ a }</a>
							}
							if len(v.UsedBy) == 0 {
								<span class="muted">no apps: link it in an app's settings</span>
							}
						</span>
					</div>
					<details>
						<summary class="box-row cursor-pointer">
							<span class="row-main">
								@ic("key-round", "icon-muted")
								<span>Variables apps get</span>
							</span>
							<span class="row-meta">show</span>
						</summary>
						for _, e := range v.Env {
							<div class="box-row">
								<div class="kv-row">
									<span class="kv-row-key">{ e.Key }</span>
									<span class="kv-row-value">{ e.Value }</span>
								</div>
								@copyButton(e.Value)
							</div>
						}
					</details>
				</div>
			}
			@section("memory", "Memory", "", nil) {
				<form hx-post={ cacheURL(v.Project.Name, v.Cache.Name) + "/memory" } class="box" id="cache-memory" data-saved>
					<div class="box-body">
						@field("Memory, MB", "When it's full, writes fail and nothing is evicted, so a queue never loses jobs. Set a TTL on cached keys.") {
							<input name="memory_mb" type="number" min="32" max="65536" required value={ fmt.Sprint(v.Cache.MemoryMB) } class="input mono"/>
						}
					</div>
					@boxFooter("It restarts with its data; apps reconnect.") {
						@submit("Save", false)
					}
				</form>
			}
			<div class="box box-danger">
				<div class="box-header">Danger zone</div>
				<div class="box-row">
					<div>
						<p class="strong">Delete this cache</p>
						if len(v.UsedBy) > 0 {
							<p class="field-hint">Unlink it from { strings.Join(v.UsedBy, ", ") } first.</p>
						} else {
							<p class="field-hint">Its server and all its data are deleted.</p>
						}
					</div>
					<button
						class="btn btn-danger"
						hx-delete={ cacheURL(v.Project.Name, v.Cache.Name) }
						hx-confirm={ "Cache " + v.Cache.Name + " and all its data are deleted." }
						data-confirm-title={ "Delete " + v.Cache.Name + "?" }
						data-confirm-action="Delete cache"
						data-confirm-name={ v.Cache.Name }
						disabled?={ len(v.UsedBy) > 0 }
					>
						@ic("trash-2")
						Delete cache
					</button>
				</div>
			</div>
		</div>
	}
}

templ cacheStatus(status string) {
	switch status {
		case "running":
			<span class="badge badge-success"><span class="dot dot-success"></span>Running</span>
		case "unknown":
			<span class="badge"><span class="dot"></span>Server not connected</span>
		case "not found":
			<span class="badge badge-danger"><span class="dot dot-danger"></span>Not running</span>
		default:
			<span class="badge badge-danger"><span class="dot dot-danger"></span>{ status }</span>
	}
}

templ cacheMeta(c store.Cache) {
	<span class="meta-item">
		@ic("zap")
		Valkey, Redis-compatible
	</span>
	<span class="meta-item">
		@ic("memory-stick")
		{ fmt.Sprintf("%d MB", c.MemoryMB) }
	</span>
	<span class="meta-item">
		@ic("archive")
		not backed up
	</span>
}
